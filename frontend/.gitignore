# ============================================
# OMNIVIA Frontend - .gitignore
# ============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep example template
!.env.example

# Vercel output
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files & Vite cache
.tmp/
.temp/
.vite/
.vite-temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
