# ============================================
# OMNIVIA Root - .gitignore
# ============================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production builds & compile artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
*.tsbuildinfo
**/*.tsbuildinfo

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.*
**/*.env
# Allow example templates
!.env.example
!**/.env.example

# Local storage and user uploads
uploads/
**/uploads/
uploads/*
**/uploads/*
!**/uploads/.gitkeep

# Cache & Temporary files
.cache/
**/.cache/
.vite/
**/.vite/
.vite-temp/
**/.vite-temp/
.tmp/
**/.tmp/
.temp/
**/.temp/
.vercel/
**/.vercel/

# Logs
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite files
*.sqlite
*.sqlite3
*.db
*.db-journal

# Prisma engine caches
.prisma/
**/prisma/generated/

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
**/.idea/
.vscode/*
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
