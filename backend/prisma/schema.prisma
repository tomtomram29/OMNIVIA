// OMNIVIA - Schema Prisma Completo
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN_OMNIVIA
  ADMIN
  MANAGER
  EMPLOYEE
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PAST_DUE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum QuoteStatus {
  DRAFT
  SENT
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  PAYPAL
  CHECK
  OTHER
}

enum DocumentType {
  QUOTE
  INVOICE
  CONTRACT
  OTHER
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  APPOINTMENT_CREATED
  APPOINTMENT_CHANGED
  INVOICE_DUE_SOON
  INVOICE_OVERDUE
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  USER_INVITED
  SYSTEM
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  SUBSCRIPTION_CHANGE
  SUSPEND
  REACTIVATE
  EXTEND_TRIAL
  PLAN_CHANGE
  INVITE_USER
  PASSWORD_CHANGE
  PASSWORD_RESET
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ItemType {
  PRODUCT
  SERVICE
}

// ============================================================
// USERS
// ============================================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  role             UserRole  @default(EMPLOYEE)
  isActive         Boolean   @default(true) @map("is_active")
  emailVerified    Boolean   @default(false) @map("email_verified")
  lastLoginAt      DateTime? @map("last_login_at")
  passwordResetToken     String?   @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  refreshToken     String?   @map("refresh_token")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  companyUsers     CompanyUser[]
  notifications    Notification[]
  assignedTasks    Task[]         @relation("TaskAssignee")
  createdTasks     Task[]         @relation("TaskCreator")
  calendarEvents   CalendarEvent[]
  auditLogs        AuditLog[]
  documents        Document[]

  @@map("users")
}

// ============================================================
// COMPANIES
// ============================================================

model Company {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  email         String
  phone         String?
  website       String?
  address       String?
  city          String?
  province      String?
  postalCode    String?       @map("postal_code")
  country       String?       @default("IT")
  vatNumber     String?       @map("vat_number")
  fiscalCode    String?       @map("fiscal_code")
  logoUrl       String?       @map("logo_url")
  status        CompanyStatus @default(TRIAL)
  internalNotes String?       @map("internal_notes")
  
  // Billing settings
  invoicePrefix    String?     @map("invoice_prefix")
  invoiceNextNumber Int        @default(1) @map("invoice_next_number")
  quotePrefix      String?     @map("quote_prefix")
  quoteNextNumber  Int         @default(1) @map("quote_next_number")
  defaultVatRate   Decimal     @default(22.00) @map("default_vat_rate") @db.Decimal(5, 2)
  currency         String      @default("EUR")
  
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  companyUsers  CompanyUser[]
  subscription  Subscription?
  clients       Client[]
  suppliers     Supplier[]
  products      Product[]
  services      Service[]
  tasks         Task[]
  calendarEvents CalendarEvent[]
  quotes        Quote[]
  invoices      Invoice[]
  documents     Document[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("companies")
}

model CompanyUser {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  role      UserRole @default(EMPLOYEE)
  isActive  Boolean  @default(true) @map("is_active")
  joinedAt  DateTime @default(now()) @map("joined_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_users")
}

// ============================================================
// PLANS & SUBSCRIPTIONS
// ============================================================

model Plan {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  priceMonthly  Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly   Decimal? @map("price_yearly") @db.Decimal(10, 2)
  currency      String   @default("EUR")
  durationDays  Int      @default(30) @map("duration_days")
  maxUsers      Int?     @map("max_users")
  maxClients    Int?     @map("max_clients")
  maxDocuments  Int?     @map("max_documents")
  features      Json?
  isActive      Boolean  @default(true) @map("is_active")
  stripePriceId String?  @map("stripe_price_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String             @id @default(uuid())
  companyId        String             @unique @map("company_id")
  planId           String?            @map("plan_id")
  status           SubscriptionStatus @default(TRIAL)
  trialStart       DateTime?          @map("trial_start")
  trialEnd         DateTime?          @map("trial_end")
  startDate        DateTime?          @map("start_date")
  endDate          DateTime?          @map("end_date")
  cancellationDate DateTime?          @map("cancellation_date")
  stripeCustomerId    String?         @map("stripe_customer_id")
  stripeSubscriptionId String?        @map("stripe_subscription_id")
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan             Plan?              @relation(fields: [planId], references: [id])
  payments         Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String        @map("subscription_id")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("EUR")
  method         PaymentMethod @default(BANK_TRANSFER)
  status         String        @default("COMPLETED")
  stripePaymentId String?      @map("stripe_payment_id")
  description    String?
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ============================================================
// CLIENTS
// ============================================================

model Client {
  id           String     @id @default(uuid())
  companyId    String     @map("company_id")
  type         ClientType @default(INDIVIDUAL)
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  businessName String?    @map("business_name")
  fiscalCode   String?    @map("fiscal_code")
  vatNumber    String?    @map("vat_number")
  email        String?
  phone        String?
  mobile       String?
  address      String?
  city         String?
  province     String?
  postalCode   String?    @map("postal_code")
  country      String?    @default("IT")
  notes        String?
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks        Task[]
  calendarEvents CalendarEvent[]
  quotes       Quote[]
  invoices     Invoice[]
  documents    Document[]

  @@map("clients")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  businessName String   @map("business_name")
  contactName  String?  @map("contact_name")
  fiscalCode   String?  @map("fiscal_code")
  vatNumber    String?  @map("vat_number")
  email        String?
  phone        String?
  address      String?
  city         String?
  province     String?
  postalCode   String?  @map("postal_code")
  country      String?  @default("IT")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@map("suppliers")
}

// ============================================================
// PRODUCTS & SERVICES
// ============================================================

model Product {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  code        String?
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  vatRate     Decimal  @default(22.00) @map("vat_rate") @db.Decimal(5, 2)
  category    String?
  unit        String?  @default("pz")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteItems  QuoteItem[]
  invoiceItems InvoiceItem[]

  @@map("products")
}

model Service {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  code        String?
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  vatRate     Decimal  @default(22.00) @map("vat_rate") @db.Decimal(5, 2)
  category    String?
  unit        String?  @default("ora")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteItems  QuoteItem[]
  invoiceItems InvoiceItem[]

  @@map("services")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @map("assignee_id")
  creatorId   String       @map("creator_id")
  clientId    String?      @map("client_id")
  dueDate     DateTime?    @map("due_date")
  completedAt DateTime?    @map("completed_at")
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  documents   Document[]

  @@map("tasks")
}

// ============================================================
// CALENDAR EVENTS
// ============================================================

model CalendarEvent {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  allDay      Boolean  @default(false) @map("all_day")
  location    String?
  color       String?  @default("#3B82F6")
  userId      String   @map("user_id")
  clientId    String?  @map("client_id")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id])

  @@map("calendar_events")
}

// ============================================================
// QUOTES
// ============================================================

model Quote {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  number       String
  clientId     String?     @map("client_id")
  status       QuoteStatus @default(DRAFT)
  issueDate    DateTime    @default(now()) @map("issue_date")
  expiryDate   DateTime?   @map("expiry_date")
  subtotal     Decimal     @default(0) @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  discountType String?     @default("AMOUNT") @map("discount_type") // AMOUNT or PERCENT
  taxable      Decimal     @default(0) @db.Decimal(10, 2)
  vatAmount    Decimal     @default(0) @map("vat_amount") @db.Decimal(10, 2)
  total        Decimal     @default(0) @db.Decimal(10, 2)
  notes        String?
  internalNotes String?    @map("internal_notes")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       Client?     @relation(fields: [clientId], references: [id])
  items        QuoteItem[]
  documents    Document[]

  @@unique([companyId, number])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String   @map("quote_id")
  itemType    ItemType @default(PRODUCT) @map("item_type")
  productId   String?  @map("product_id")
  serviceId   String?  @map("service_id")
  description String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  vatRate     Decimal  @default(22.00) @map("vat_rate") @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  vatAmount   Decimal  @map("vat_amount") @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])

  @@map("quote_items")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  number          String
  clientId        String?       @map("client_id")
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now()) @map("issue_date")
  dueDate         DateTime?     @map("due_date")
  paymentMethod   PaymentMethod? @map("payment_method")
  subtotal        Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  discountType    String?       @default("AMOUNT") @map("discount_type")
  taxable         Decimal       @default(0) @db.Decimal(10, 2)
  vatAmount       Decimal       @default(0) @map("vat_amount") @db.Decimal(10, 2)
  total           Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  remainingAmount Decimal       @default(0) @map("remaining_amount") @db.Decimal(10, 2)
  notes           String?
  internalNotes   String?       @map("internal_notes")
  quoteId         String?       @map("quote_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client?       @relation(fields: [clientId], references: [id])
  items           InvoiceItem[]
  invoicePayments InvoicePayment[]
  documents       Document[]

  @@unique([companyId, number])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  itemType    ItemType @default(PRODUCT) @map("item_type")
  productId   String?  @map("product_id")
  serviceId   String?  @map("service_id")
  description String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  vatRate     Decimal  @default(22.00) @map("vat_rate") @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  vatAmount   Decimal  @map("vat_amount") @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])

  @@map("invoice_items")
}

model InvoicePayment {
  id          String        @id @default(uuid())
  invoiceId   String        @map("invoice_id")
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  paidAt      DateTime      @default(now()) @map("paid_at")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_payments")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  name        String
  originalName String      @map("original_name")
  mimeType    String       @map("mime_type")
  size        Int
  path        String
  type        DocumentType @default(OTHER)
  uploadedById String      @map("uploaded_by_id")
  clientId    String?      @map("client_id")
  supplierId  String?      @map("supplier_id")
  taskId      String?      @map("task_id")
  quoteId     String?      @map("quote_id")
  invoiceId   String?      @map("invoice_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  task        Task?        @relation(fields: [taskId], references: [id])
  quote       Quote?       @relation(fields: [quoteId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])

  @@map("documents")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  companyId String           @map("company_id")
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?
  createdAt DateTime         @default(now()) @map("created_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String?     @map("company_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entity     String?
  entityId   String?     @map("entity_id")
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  description String?
  createdAt  DateTime    @default(now()) @map("created_at")

  company    Company?    @relation(fields: [companyId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
